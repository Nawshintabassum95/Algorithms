#include <bits/stdc++.h>
using namespace std;

// Partition the array around the pivot
int partitionArray(int a[], int low, int high)
{
    int pivot = a[high];
    int i = low - 1;
// Check each element before the pivot
    for (int j = low; j < high; j++)
    {
        if (a[j] <= pivot)
        {
            i++;

// Swap smaller element to the left side
            int temp = a[i];
            a[i] = a[j];
            a[j] = temp;
        }
    }
// Place pivot in its correct position
    int temp = a[i + 1];
    a[i + 1] = a[high];
    a[high] = temp;

    return i + 1;
}

// Divide and Conquer function
void quickSort(int a[], int low, int high)
{
    if (low < high)
    {
        int p = partitionArray(a, low, high);
        quickSort(a, low, p - 1);
        quickSort(a, p + 1, high);
    }
}

int main()
{
    int n;
    cin >> n;
    int a[1000];
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }
    quickSort(a, 0, n - 1);
    for (int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }
    return 0;
}
